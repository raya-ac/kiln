[Unit]
Description=Prune expired Kiln session and rate-limit rows
After=kiln-account.service

[Service]
Type=oneshot
User=kiln-account
Group=kiln-account
WorkingDirectory=/opt/kiln-account/current
Environment="KILN_DATABASE_URL=host=/var/run/postgresql dbname=kiln_account user=kiln-account"
ExecStart=/opt/kiln-account/current/.venv/bin/python db.py prune
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/kiln-account
RestrictAddressFamilies=AF_UNIX
